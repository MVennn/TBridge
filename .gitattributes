# 统一换行符：全局 LF，避免 Windows / macOS 协作时整文件 diff
* text=auto eol=lf

# Shell / Gradle wrapper 必须 LF，否则 Linux CI 的 shebang 会失效
*.sh text eol=lf
gradlew text eol=lf

# CI 工作流与脚本同理；CRLF 会让 Actions 的 shell 步骤找不到解释器
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf

# Windows 批处理必须 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 文本类型显式标记，避免 GitHub 语言识别漂移
*.java text
*.kt text
*.kts text
*.xml text
*.md text
*.svg text eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.jar binary
*.keystore binary
*.apk binary
*.ico binary
